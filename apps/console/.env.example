# Copy to .env.local for development. In production these are set in cPanel (see docs/DEPLOY_CPANEL.md).
DATABASE_URL=postgres://reorder:reorder@localhost:5432/reorder_dev
# At least 32 random characters. Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-48-characters
# Public address of the console (used in invite links). http://localhost:3000 in development.
APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=amipi.com
# Sign in with Microsoft / Google (docs/DEPLOY_CPANEL.md steps 4a and 4b). Leave empty to use password sign-in.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Keep username/email + password sign-in as well: on / off (default: on only when no provider is set).
# PASSWORD_LOGIN=on
# Also ask for a 6-digit code from an authenticator app after the password: on / off (default off).
# AUTHENTICATOR_CODE=on
# Email for "Forgot password" (docs/DEPLOY_CPANEL.md step 4c). Without it, development prints the email in the terminal.
# SMTP_HOST=mail.nobulldiamond.com
# SMTP_PORT=465
# SMTP_USER=no-reply@nobulldiamond.com
# SMTP_PASSWORD=
# MAIL_FROM=AMIPI Reorder Console <no-reply@nobulldiamond.com>
# Sending through Mailchimp (docs/DEPLOY_CPANEL.md step 4d). Without these, use the CSV export.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
